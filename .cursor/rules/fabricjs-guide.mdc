## Fabric.js v6+ Canvas Guide for React (Next.js)

This guide shows the correct setup for Fabric.js version 6+ in React/Next.js, including imports, pre-built object interactions (selection, dragging, scaling, rotation, skewing), and drawing mode with available brushes (PencilBrush, CircleBrush, PatternBrush). It also includes React-friendly cleanup and testing notes.

References: https://fabricjs.com/docs/core-concepts/ , https://fabricjs.com/docs/configuring-controls/

---

### Installation

```bash
npm install fabric
# or
yarn add fabric
```

---

### Imports (ESM, TypeScript) for Fabric v6+

Prefer named imports for tree-shaking. If you need a namespace, use the named `fabric` export (not a default export).

```ts
// Recommended (tree-shakeable)
import {
  Canvas,
  StaticCanvas,
  Control,
  Rect,
  Circle,
  FabricText,
  IText,
  Textbox,
  PencilBrush,
  CircleBrush,
  PatternBrush,
} from "fabric";

// Optional namespace form
import { fabric } from "fabric";
```

---

### React Canvas Component (Client Component)

- Use the "use client" directive for components that use browser APIs.
- Initialize and dispose `Canvas` properly.
- Add basic accessibility.

```tsx
"use client";

import React, { useCallback, useEffect, useRef } from "react";
import { Canvas, Rect, Circle, FabricText } from "fabric";
import { cn } from "@/lib/cn"; // ensure this utility exists in your project

interface FabricCanvasProps {
  width?: number;
  height?: number;
  className?: string;
  onCanvasReady?: (canvas: Canvas) => void;
}

export default function FabricCanvas({
  width = 800,
  height = 600,
  className,
  onCanvasReady,
}: FabricCanvasProps) {
  const canvasElRef = useRef<HTMLCanvasElement | null>(null);
  const canvasRef = useRef<Canvas | null>(null);

  const init = useCallback(() => {
    if (!canvasElRef.current) return;

    const canvas = new Canvas(canvasElRef.current, {
      width,
      height,
      backgroundColor: "#ffffff",
      selection: true,
      preserveObjectStacking: true,
    });

    canvasRef.current = canvas;

    // Example objects
    const rect = new Rect({
      left: 80,
      top: 80,
      width: 120,
      height: 80,
      fill: "#ef4444",
    });
    const circle = new Circle({
      left: 250,
      top: 120,
      radius: 50,
      fill: "#3b82f6",
    });
    const text = new FabricText("Hello Fabric v6", {
      left: 150,
      top: 240,
      fontSize: 22,
    });

    canvas.add(rect, circle, text);
    canvas.requestRenderAll();

    onCanvasReady?.(canvas);
  }, [height, onCanvasReady, width]);

  useEffect(() => {
    init();
    return () => {
      canvasRef.current?.dispose();
      canvasRef.current = null;
    };
  }, [init]);

  return (
    <canvas
      ref={canvasElRef}
      aria-label="Fabric drawing canvas"
      className={cn("rounded-lg border border-gray-300", className)}
    />
  );
}
```

