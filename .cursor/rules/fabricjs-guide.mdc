### React Event Wiring & Cleanup

Use `on`/`off` with cleanup to avoid leaks.

```ts
useEffect(() => {
  const c = canvasRef.current;
  if (!c) return;

  const handlePathCreated = (e: any) => {
    // ...
  };
  const handleModified = (e: any) => {
    // ...
  };

  c.on("path:created", handlePathCreated);
  c.on("object:modified", handleModified);

  return () => {
    c.off("path:created", handlePathCreated);
    c.off("object:modified", handleModified);
  };
}, []);
```

