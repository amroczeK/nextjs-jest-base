### Drawing Mode & Brushes (PencilBrush, CircleBrush, PatternBrush)

Enable drawing mode on the canvas and assign one of the available brushes.

```ts
canvas.isDrawingMode = true;
```

PencilBrush:

```ts
import { PencilBrush } from "fabric";

const pencil = new PencilBrush(canvas);
pencil.color = "#111827"; // gray-900
pencil.width = 5;
canvas.freeDrawingBrush = pencil;

canvas.on("path:created", (e) => {
  // e.path is the created Path
});
```

CircleBrush:

```ts
import { CircleBrush } from "fabric";

const dots = new CircleBrush(canvas);
// CircleBrush "width" is effectively the dot diameter
dots.color = "#2563eb";
dots.width = 12;
canvas.freeDrawingBrush = dots;
```

PatternBrush (provide a canvas source via getPatternSrc):

```ts
import { PatternBrush, StaticCanvas, Rect } from "fabric";

const pattern = new PatternBrush(canvas);
pattern.getPatternSrc = () => {
  const tempCanvasEl = document.createElement("canvas");
  tempCanvasEl.width = 24;
  tempCanvasEl.height = 24;

  const temp = new StaticCanvas(tempCanvasEl);
  const tile = new Rect({
    left: 0,
    top: 0,
    width: 24,
    height: 24,
    fill: "#f59e0b",
  });
  temp.add(tile);
  temp.requestRenderAll();

  return temp.getElement(); // HTMLCanvasElement
};

pattern.width = 8;
pattern.color = "#000000"; // outline color for the stroke built by the brush
canvas.freeDrawingBrush = pattern;
```

Switch brushes at runtime:

```ts
function setBrush(type: "pencil" | "circle" | "pattern") {
  switch (type) {
    case "pencil": {
      const b = new PencilBrush(canvas);
      b.color = "#000";
      b.width = 4;
      canvas.freeDrawingBrush = b;
      break;
    }
    case "circle": {
      const b = new CircleBrush(canvas);
      b.color = "#dc2626";
      b.width = 10;
      canvas.freeDrawingBrush = b;
      break;
    }
    case "pattern": {
      const b = new PatternBrush(canvas);
      b.getPatternSrc = pattern.getPatternSrc;
      b.width = 6;
      canvas.freeDrawingBrush = b;
      break;
    }
  }
}
```

