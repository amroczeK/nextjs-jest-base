### Custom Controls (documented v6 approach)

Avoid undocumented utilities. Use `Control` with a handler.

```ts
import { Control } from "fabric";

// Add a delete control to top-left of an object
rect.controls.deleteControl = new Control({
  x: -0.5,
  y: -0.5,
  offsetX: -8,
  offsetY: -8,
  cursorStyle: "pointer",
  mouseUpHandler: (_evt, transform) => {
    const target = transform.target;
    target.canvas?.remove(target);
    target.canvas?.requestRenderAll();
    return true;
  },
  render: (ctx, left, top) => {
    const size = 14;
    ctx.save();
    ctx.translate(left, top);
    ctx.fillStyle = "#ef4444";
    ctx.fillRect(-size / 2, -size / 2, size, size);
    ctx.restore();
  },
});

canvas.requestRenderAll();
```

